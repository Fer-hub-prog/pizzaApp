<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.pizza_app">

    <!-- Internet é necessário para o Google Maps -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- (Opcional, só se for usar localização real) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:label="pizza_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- 🔑 Chave do Google Maps: FICA DENTRO DE <application>, FORA DA <activity> -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBMNFQA4tzeqIkJJKfAvC_68slh5XFdV4k" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Tema normal do Flutter enquanto inicializa -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Não remover: usado pelo Flutter -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>